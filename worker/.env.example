# Same database as the API.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Optional LLM pass (the table parser always runs). Every LLM value is checked against the PDF.
LLM_PROVIDERS=groq,gemini,openai,ollama
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b
LLM_MAX_CALLS_PER_REPORT=4

# Must match the API (auto = gemini if GEMINI_API_KEY is set, else openai, else none)
EMBEDDINGS_PROVIDER=auto

# Keep downloaded PDFs in Postgres so page citations open in the browser (uses DB storage).
STORE_FETCHED_PDFS=false
MAX_DOWNLOAD_MB=80
OCR_MAX_PAGES=15
