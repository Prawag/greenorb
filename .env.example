# ── docker compose reads this file (copy to .env). The frontend dev server reads VITE_* only. ──

# Reviewer token: required to submit reports, review flags and verify values.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# LLM providers (all optional; tried in this order). Without any, GreenOrb uses its table parser only.
LLM_PROVIDERS=groq,gemini,openai,ollama
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Semantic search embeddings: auto | gemini | openai | ollama | none (API and worker must match)
EMBEDDINGS_PROVIDER=auto

# Frontend (only when the API is on another origin, e.g. Vercel + Render)
VITE_API_BASE=
