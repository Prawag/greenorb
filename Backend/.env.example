# Postgres 14+ (Neon recommended). The API creates/migrates the `esg` schema on start
# and never touches legacy public.* tables.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
PORT=5000
# Comma-separated browser origins allowed to call the API (localhost is allowed in development).
ALLOWED_ORIGINS=http://localhost:5173

# Reviewer token (long random string). Required for ingest/review/edit endpoints.
ADMIN_TOKEN=
# Let anyone submit reports (rate-limited) instead of reviewers only.
PUBLIC_INGEST=false
MAX_UPLOAD_MB=40

# Ask-the-report answers (OpenAI-compatible providers, tried in order)
LLM_PROVIDERS=groq,gemini,openai,ollama
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b
EMBEDDINGS_PROVIDER=auto
